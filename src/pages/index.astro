---
// Rendered per request: the next session is computed from the current date,
// so this page must not be baked at build time.
export const prerender = false;

import BaseHead from "../components/BaseHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/sections/Hero.astro";
import Why from "../components/sections/Why.astro";
import WhatWeDo from "../components/sections/WhatWeDo.astro";
import Join from "../components/sections/Join.astro";
import WhoItsFor from "../components/sections/WhoItsFor.astro";
import Rules from "../components/sections/Rules.astro";
import HowToPrepare from "../components/sections/HowToPrepare.astro";
import WhatThisIsnt from "../components/sections/WhatThisIsnt.astro";
import WhoIAm from "../components/sections/WhoIAm.astro";
import CoHost from "../components/sections/CoHost.astro";
import FAQ from "../components/sections/FAQ.astro";
import NextSession from "../components/sections/NextSession.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Nav />
    <main>
      <Hero />
      <Why />
      <WhatWeDo />
      <Join />
      <WhoItsFor />
      <Rules />
      <HowToPrepare />
      <WhatThisIsnt />
      <WhoIAm />
      <CoHost />
      <FAQ />
      <NextSession />
    </main>
    <Footer />
  </body>
</html>
