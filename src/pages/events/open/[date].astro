---
// Rendered per request: needs the signup cookie and the current "next session"
// to decide what to show, so this can't be baked at build time.
export const prerender = false;

import { getCollection, getEntry, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Container from "../../../components/Container.astro";
import SectionHeading from "../../../components/SectionHeading.astro";
import EventHero from "../../../components/EventHero.astro";
import Button from "../../../components/Button.astro";
import CopyButton from "../../../components/CopyButton.astro";
import OpenGroupSignupForm from "../../../components/OpenGroupSignupForm.astro";
import SessionElementCard from "../../../components/SessionElementCard.astro";
import HowToPrepare from "../../../components/sections/HowToPrepare.astro";
import {
  HOST_NAME,
  CO_HOST_NAME,
  HOST_IMAGE,
  CO_HOST_IMAGE,
  getNextOpenSession,
  getSessionByDate,
} from "../../../data/sessions";
import { formatSessionLabel, formatSessionLabelWithYear, hasSessionEnded } from "../../../lib/berlin-time";
import { buildGoogleCalendarLink } from "../../../lib/ics";
import { isConfirmedForDate, readSignupCookieValue } from "../../../lib/signup-cookie";

const session = getSessionByDate(Astro.params.date ?? "");
if (!session) Astro.response.status = 404;

const whyEntry = (await getEntry("copy", "why"))!;
const { Content: Why } = await render(whyEntry);

// Reuses the homepage's "how it works" steps rather than re-explaining the
// sign-up flow in fresh copy here.
const steps = (await getCollection("howItWorks")).sort((a, b) => a.data.order - b.data.order);
const stepCards = await Promise.all(
  steps.map(async (step, index) => {
    const { Content } = await render(step);
    return { title: step.data.title, number: index + 1, Content };
  }),
);

const cookie = readSignupCookieValue(Astro.cookies);
const confirmedHere = session ? isConfirmedForDate(cookie, session.date) : false;
const pendingHere = session ? cookie?.sessionDate === session.date && cookie.status === "pending" : false;
const finished = session ? hasSessionEnded(session.date, session.time, session.durationMinutes) : false;
const isNextSession = session ? session.date === getNextOpenSession()?.date : false;
// Only the visitor's currently-active signup carries a token — a purely historical
// confirmation (in `confirmed`) has none, so it can't drive an .ics re-download.
const liveToken = session && cookie?.sessionDate === session.date ? cookie.token : undefined;

const zoomLink = confirmedHere ? Astro.locals.runtime.env.ZOOM_LINK : null;
const googleCalendarLink =
  confirmedHere && session && zoomLink ? buildGoogleCalendarLink(session, zoomLink) : null;
const icsUrl = liveToken ? `/api/ics?token=${liveToken}` : null;
---

<Layout
  title={session ? `${formatSessionLabelWithYear(session.date)} — Inner Work` : "Session not found — Inner Work"}
  description="Details for an Inner Work open group session, including how to join."
>
  <Container background="hero" class="py-12 md:py-20">
    {
      !session ? (
        <p class="text-lg text-solarized-textSecondary">
          That session date isn't part of the schedule. Head back to the <a href="/#join">Join</a> section
          to see upcoming sessions.
        </p>
      ) : (
        <>
          <EventHero
            kind="Open group session"
            dateISO={session.date}
            time={session.time}
            hostName={HOST_NAME}
            hostImage={HOST_IMAGE}
            coHostName={session.coHost ? CO_HOST_NAME : undefined}
            coHostImage={session.coHost ? CO_HOST_IMAGE : undefined}
          >
            {confirmedHere ? (
              <>
                <p class="mb-0 text-base leading-normal font-semibold text-solarized-textHeading">
                  {finished ? "You were confirmed for this session." : "You're confirmed — see you there."}
                </p>
                {zoomLink && (
                  <div class="mt-4 border-t border-solarized-base2 pt-4">
                    <p class="mb-0 flex flex-wrap items-center gap-2 text-base leading-normal text-solarized-textBody">
                      Join on Zoom: <a href={zoomLink}>{zoomLink}</a>
                      <CopyButton value={zoomLink} label="Copy Zoom link" />
                    </p>
                  </div>
                )}
                {(googleCalendarLink || icsUrl) && (
                  <div class="mt-4 flex flex-wrap gap-3 border-t border-solarized-base2 pt-4">
                    {googleCalendarLink && <Button href={googleCalendarLink}>Add to Google Calendar</Button>}
                    {icsUrl && <Button href={icsUrl}>Download calendar file (.ics)</Button>}
                  </div>
                )}
              </>
            ) : pendingHere ? (
              <p class="mb-0">You're signed up — check your email to confirm and get the Zoom link.</p>
            ) : finished ? (
              <p class="mb-0">This session has already taken place.</p>
            ) : isNextSession ? (
              <>
                <p class="mb-4 text-center font-heading text-2xl font-semibold text-solarized-textHeading">
                  Reserve your spot
                </p>
                <OpenGroupSignupForm
                  sessionDate={session.date}
                  sessionLabel={formatSessionLabel(session.date)}
                  showHint={false}
                />
              </>
            ) : (
              <p class="mb-0">
                Sign-up opens once this becomes the next session — see the <a href="/#join">Join</a> section.
              </p>
            )}
          </EventHero>

          <div class="mt-14 grid gap-6 sm:grid-cols-3">
            {stepCards.map(({ title, number, Content }) => (
              <SessionElementCard title={title} number={number} background="tint">
                <Content />
              </SessionElementCard>
            ))}
          </div>
        </>
      )
    }
  </Container>

  {session && (
    <Container>
      <SectionHeading title="What this is" id="what-this-is" />
      <div class="prose max-w-none mt-6">
        <Why />
      </div>
    </Container>
  )}

  {session && <HowToPrepare />}
</Layout>
