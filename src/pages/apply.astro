---
import { getEntry, render } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ClosedGroupApplicationForm from "../components/ClosedGroupApplicationForm.astro";
import { getNextClosedCycle } from "../data/closed-cycles";
import { formatSessionLabel } from "../lib/berlin-time";

const cycle = getNextClosedCycle();
const startDateLabel = cycle ? formatSessionLabel(cycle.startDate) : null;

const introEntry = (await getEntry("copy", "apply-intro"))!;
const { Content: Intro } = await render(introEntry);
const notOpenEntry = (await getEntry("copy", "apply-not-open"))!;
const { Content: NotOpen } = await render(notOpenEntry);
---

<Layout
  title="Apply — Practice group for inner work"
  description="Apply for the next cycle of the closed group."
>
  <Container class="max-w-2xl">
    <div class="prose">
      <SectionHeading title="Apply for the closed group" />
      {cycle && startDateLabel ? <Intro /> : <NotOpen />}
    </div>
    {
      cycle && startDateLabel && (
        <ClosedGroupApplicationForm startDateLabel={startDateLabel} startDate={cycle.startDate} />
      )
    }
  </Container>
</Layout>
