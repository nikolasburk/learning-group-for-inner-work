---
import { getEntry, render } from "astro:content";
import Container from "../Container.astro";
import SectionHeading from "../SectionHeading.astro";
import Avatar from "../Avatar.astro";

const entry = (await getEntry("copy", "co-host"))!;
const { Content } = await render(entry);
---

<Container background="tint">
  <SectionHeading title="Co-host" id="co-host" />
  <div class="flex flex-col md:flex-row gap-8 items-center mt-6">
    <Avatar src="/images/rvilla.webp" alt="Rosa Villa" />
    <div class="prose flex-1">
      <Content />
    </div>
  </div>
</Container>
