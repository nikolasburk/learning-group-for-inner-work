---
import { getCollection, getEntry, render } from "astro:content";
import Container from "../Container.astro";
import SectionHeading from "../SectionHeading.astro";
import SessionElementCard from "../SessionElementCard.astro";

const entry = (await getEntry("copy", "what-we-do"))!;
const { Content } = await render(entry);

const elements = (await getCollection("sessionElements")).sort(
  (a, b) => a.data.order - b.data.order,
);
const cards = await Promise.all(
  elements.map(async (element) => {
    const { Content } = await render(element);
    return { title: element.data.title, Content };
  }),
);
---

<Container background="tint">
  <SectionHeading title="What we do" id="what-we-do" />
  <div class="prose max-w-none mt-6">
    <Content />
  </div>
  <div class="grid gap-6 lg:grid-cols-3 mt-8">
    {
      cards.map(({ title, Content }) => (
        <SessionElementCard title={title}>
          <Content />
        </SessionElementCard>
      ))
    }
  </div>
</Container>
