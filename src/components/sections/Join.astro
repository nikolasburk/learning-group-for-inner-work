---
import { getEntry, render } from "astro:content";
import Container from "../Container.astro";
import SectionHeading from "../SectionHeading.astro";
import JoinCard from "../JoinCard.astro";
import MiniCalendar from "../MiniCalendar.astro";
import OpenGroupSignupForm from "../OpenGroupSignupForm.astro";
import {
  OPEN_GROUP_SESSIONS,
  HOST_NAME,
  CO_HOST_NAME,
  HOST_IMAGE,
  CO_HOST_IMAGE,
  getNextOpenSession,
} from "../../data/sessions";
import { CLOSED_GROUP_SESSIONS, getNextClosedCycle } from "../../data/closed-cycles";
import { formatSessionLabel } from "../../lib/berlin-time";

const introEntry = (await getEntry("copy", "join-intro"))!;
const { Content: Intro } = await render(introEntry);
const openOutroEntry = (await getEntry("copy", "join-open-outro"))!;
const { Content: OpenOutro } = await render(openOutroEntry);
const closedOutroEntry = (await getEntry("copy", "join-closed-outro"))!;
const { Content: ClosedOutro } = await render(closedOutroEntry);
const notSureEntry = (await getEntry("copy", "join-not-sure"))!;
const { Content: NotSure } = await render(notSureEntry);
const costEntry = (await getEntry("copy", "join-cost"))!;
const { Content: Cost } = await render(costEntry);

const nextSession = getNextOpenSession();
const nextSessionLabel = nextSession
  ? formatSessionLabel(nextSession.date)
  : null;
const closedCycle = getNextClosedCycle();

// Matches a session list's entries into the given month's hover-card data.
// Days with no match (e.g. already-past sessions) stay non-interactive.
function sessionsForMonth<T extends { date: string; time: string; durationMinutes: number }>(
  sessions: T[],
  year: number,
  month: number,
  options: { coHost?: (session: T) => boolean; isNext?: (session: T) => boolean } = {},
) {
  const monthPrefix = `${year}-${String(month).padStart(2, "0")}`;
  return sessions
    .filter((session) => session.date.startsWith(monthPrefix))
    .map((session) => ({
      day: Number(session.date.slice(8, 10)),
      date: session.date,
      time: session.time,
      durationMinutes: session.durationMinutes,
      coHost: options.coHost?.(session) ?? false,
      isNext: options.isNext?.(session) ?? false,
    }));
}

function openSessionsForMonth(year: number, month: number) {
  return sessionsForMonth(OPEN_GROUP_SESSIONS, year, month, {
    coHost: (session) => session.coHost,
    isNext: (session) => nextSession !== null && session.date === nextSession.date,
  });
}

function closedSessionsForMonth(year: number, month: number) {
  return sessionsForMonth(CLOSED_GROUP_SESSIONS, year, month);
}
---

<Container>
  <SectionHeading title="Two ways to join" id="join" />
  <div class="text-lg text-solarized-textSecondary mt-6 mb-8">
    <Intro />
  </div>
  <div class="grid md:grid-cols-2 gap-6 md:gap-8">
    <JoinCard
      title="The open group"
      note="Free, no application, no commitment."
      cadence="2nd & 4th Wednesday of the month"
      time="19:00 Berlin"
      sessionDate={nextSession?.date}
      sessionTime={nextSession?.time}
    >
      {
        nextSession && nextSessionLabel && (
          <Fragment slot="cta">
            <OpenGroupSignupForm
              sessionDate={nextSession.date}
              sessionLabel={nextSessionLabel}
            />
          </Fragment>
        )
      }
      <MiniCalendar
        slot="calendar"
        startIndex={0}
        host={HOST_NAME}
        coHostName={CO_HOST_NAME}
        hostImage={HOST_IMAGE}
        coHostImage={CO_HOST_IMAGE}
        months={[
          {
            label: "August",
            year: 2026,
            daysInMonth: 31,
            startWeekday: 5,
            highlighted: [26],
            sessions: openSessionsForMonth(2026, 8),
          },
          {
            label: "September",
            year: 2026,
            daysInMonth: 30,
            startWeekday: 1,
            highlighted: [9, 23],
            sessions: openSessionsForMonth(2026, 9),
          },
          {
            label: "October",
            year: 2026,
            daysInMonth: 31,
            startWeekday: 3,
            highlighted: [14, 28],
            sessions: openSessionsForMonth(2026, 10),
          },
          {
            label: "November",
            year: 2026,
            daysInMonth: 30,
            startWeekday: 6,
            highlighted: [11, 25],
            sessions: openSessionsForMonth(2026, 11),
          },
          {
            label: "December",
            year: 2026,
            daysInMonth: 31,
            startWeekday: 1,
            highlighted: [9, 23],
            sessions: openSessionsForMonth(2026, 12),
          },
          {
            label: "January",
            year: 2027,
            daysInMonth: 31,
            startWeekday: 4,
            highlighted: [13, 27],
            sessions: openSessionsForMonth(2027, 1),
          },
        ]}
      />
      <OpenOutro />
    </JoinCard>
    <JoinCard
      title="The closed group"
      note="3 months starting in September (6 sessions in total)"
      cadence="1st & 3rd Wednesday of the month"
      time="19:00 Berlin"
      sessionDate={closedCycle?.startDate}
      ctaLabel="Apply for the next cycle →"
      ctaHref="/apply"
      footnote="Applications close September 9. I'll get back to everyone either way."
    >
      <MiniCalendar
        slot="calendar"
        startIndex={0}
        host={HOST_NAME}
        hostImage={HOST_IMAGE}
        signupEnabled={false}
        months={[
          {
            label: "September",
            year: 2026,
            daysInMonth: 30,
            startWeekday: 1,
            highlighted: [16],
            sessions: closedSessionsForMonth(2026, 9),
          },
          {
            label: "October",
            year: 2026,
            daysInMonth: 31,
            startWeekday: 3,
            highlighted: [7, 21],
            sessions: closedSessionsForMonth(2026, 10),
          },
          {
            label: "November",
            year: 2026,
            daysInMonth: 30,
            startWeekday: 6,
            highlighted: [4, 18],
            sessions: closedSessionsForMonth(2026, 11),
          },
          {
            label: "December",
            year: 2026,
            daysInMonth: 31,
            startWeekday: 1,
            highlighted: [2],
            sessions: closedSessionsForMonth(2026, 12),
          },
          {
            label: "January",
            year: 2027,
            daysInMonth: 31,
            startWeekday: 4,
            highlighted: [],
          },
          {
            label: "February",
            year: 2027,
            daysInMonth: 28,
            startWeekday: 0,
            highlighted: [],
          },
        ]}
      />
      <ClosedOutro />
    </JoinCard>
  </div>
  <div class="text-center text-solarized-textSecondary mt-8">
    <NotSure />
  </div>
  <div class="text-center text-solarized-textSecondary mt-4">
    <Cost />
  </div>
</Container>
