---
import { getEntry, render } from "astro:content";
import Container from "../Container.astro";
import SectionHeading from "../SectionHeading.astro";
import JoinCard from "../JoinCard.astro";
import MiniCalendar from "../MiniCalendar.astro";
import OpenGroupSignupForm from "../OpenGroupSignupForm.astro";
import {
  HOST_NAME,
  CO_HOST_NAME,
  HOST_IMAGE,
  CO_HOST_IMAGE,
  getNextOpenSession,
  getSessionsInMonth,
} from "../../data/sessions";
import { getClosedSessionsForCycle, getNextClosedCycle } from "../../data/closed-cycles";
import { formatSessionLabel, hasSessionEnded } from "../../lib/berlin-time";
import {
  berlinMonthOf,
  daysInMonth,
  mondayFirstWeekday,
  monthLabel,
  monthsFrom,
} from "../../lib/recurrence";

const introEntry = (await getEntry("copy", "join-intro"))!;
const { Content: Intro } = await render(introEntry);
const openOutroEntry = (await getEntry("copy", "join-open-outro"))!;
const { Content: OpenOutro } = await render(openOutroEntry);
const closedOutroEntry = (await getEntry("copy", "join-closed-outro"))!;
const { Content: ClosedOutro } = await render(closedOutroEntry);
const notSureEntry = (await getEntry("copy", "join-not-sure"))!;
const { Content: NotSure } = await render(notSureEntry);
const costEntry = (await getEntry("copy", "join-cost"))!;
const { Content: Cost } = await render(costEntry);

const nextSession = getNextOpenSession();
const nextSessionLabel = nextSession
  ? formatSessionLabel(nextSession.date)
  : null;
const closedCycle = getNextClosedCycle();
const closedSessions = closedCycle ? getClosedSessionsForCycle(closedCycle) : [];
const closedDeadlineLabel = closedCycle
  ? formatSessionLabel(closedCycle.applicationDeadline)
  : null;
// Derived from the cycle so the card can't advertise a month or a deadline the
// schedule has already moved past.
const closedNote = closedCycle
  ? `3 months starting in ${monthLabel(
      Number(closedCycle.startDate.slice(0, 4)),
      Number(closedCycle.startDate.slice(5, 7)),
    )} (${closedSessions.length} sessions in total)`
  : "Applications are closed for now.";
const closedFootnote = closedDeadlineLabel
  ? `Applications close ${closedDeadlineLabel}. I'll get back to everyone either way.`
  : undefined;

// How many months the calendar lets you page through.
const CALENDAR_MONTHS = 6;

// The calendars span from the current Berlin month onwards, so the view is never
// stranded on a month that has already passed.
// One instant for the whole render, so every cell agrees on what counts as past.
const now = new Date();
const calendarStart = berlinMonthOf(now);

// Turns a month's sessions into the calendar's hover-card data. `highlighted` is
// derived from the same list rather than hand-typed alongside it, so the two can
// no longer drift apart.
function buildMonth<T extends { date: string; time: string; durationMinutes: number }>(
  year: number,
  month: number,
  sessions: T[],
  options: {
    coHost?: (session: T) => boolean;
    isNext?: (session: T) => boolean;
    oneOff?: (session: T) => boolean;
  } = {},
) {
  const details = sessions.map((session) => ({
    day: Number(session.date.slice(8, 10)),
    date: session.date,
    time: session.time,
    durationMinutes: session.durationMinutes,
    coHost: options.coHost?.(session) ?? false,
    isNext: options.isNext?.(session) ?? false,
    // Left undefined rather than defaulted to false: that is what tells the calendar
    // this schedule has no notion of one-offs, so the closed group shows no badge.
    oneOff: options.oneOff ? options.oneOff(session) : undefined,
    isPast: hasSessionEnded(session.date, session.time, session.durationMinutes, now),
  }));
  return {
    label: monthLabel(year, month),
    year,
    daysInMonth: daysInMonth(year, month),
    startWeekday: mondayFirstWeekday(year, month),
    highlighted: details.map((detail) => detail.day),
    sessions: details,
  };
}

const calendarMonths = monthsFrom(calendarStart.year, calendarStart.month, CALENDAR_MONTHS);

const monthPrefix = (year: number, month: number) => `${year}-${String(month).padStart(2, "0")}`;

// Which panel a calendar opens on: the month holding its next upcoming session rather
// than the current one, so a month whose sessions have all passed doesn't greet you
// with an empty grid while the next date sits one page over.
function monthIndexOf(dateISO: string | undefined): number {
  if (!dateISO) return 0;
  const index = calendarMonths.findIndex(({ year, month }) =>
    dateISO.startsWith(monthPrefix(year, month)),
  );
  return index === -1 ? 0 : index;
}

const openMonths = calendarMonths.map(({ year, month }) =>
  buildMonth(year, month, getSessionsInMonth(year, month), {
    coHost: (session) => session.coHost,
    isNext: (session) => session.date === nextSession?.date,
    oneOff: (session) => session.oneOff,
  }),
);

const closedMonths = calendarMonths.map(({ year, month }) => {
  const prefix = monthPrefix(year, month);
  const inMonth = closedSessions.filter((session) => session.date.startsWith(prefix));
  return buildMonth(year, month, inMonth);
});

const openStartIndex = monthIndexOf(nextSession?.date);
const nextClosedSession = closedSessions.find(
  (session) => !hasSessionEnded(session.date, session.time, session.durationMinutes, now),
);
const closedStartIndex = monthIndexOf(nextClosedSession?.date ?? closedCycle?.startDate);
---

<Container>
  <SectionHeading title="Two ways to join" id="join" />
  <div class="text-lg text-solarized-textSecondary mt-6 mb-8">
    <Intro />
  </div>
  <div class="grid md:grid-cols-2 gap-6 md:gap-8">
    <JoinCard
      title="The open group"
      note="Free, no application, no commitment."
      cadence="2nd & 4th Wednesday of the month + one-off sessions"
      time="19:00 Berlin"
      sessionDate={nextSession?.date}
      sessionTime={nextSession?.time}
    >
      {
        nextSession && nextSessionLabel && (
          <Fragment slot="cta">
            <OpenGroupSignupForm
              sessionDate={nextSession.date}
              sessionLabel={nextSessionLabel}
            />
          </Fragment>
        )
      }
      <MiniCalendar
        slot="calendar"
        startIndex={openStartIndex}
        host={HOST_NAME}
        coHostName={CO_HOST_NAME}
        hostImage={HOST_IMAGE}
        coHostImage={CO_HOST_IMAGE}
        months={openMonths}
      />
      <OpenOutro />
    </JoinCard>
    <JoinCard
      title="The closed group"
      note={closedNote}
      cadence="1st & 3rd Wednesday of the month"
      time="19:00 Berlin"
      sessionDate={closedCycle?.startDate}
      ctaLabel="Apply for the next cycle →"
      ctaHref="/apply"
      footnote={closedFootnote}
    >
      <MiniCalendar
        slot="calendar"
        startIndex={closedStartIndex}
        host={HOST_NAME}
        hostImage={HOST_IMAGE}
        signupEnabled={false}
        months={closedMonths}
      />
      <ClosedOutro />
    </JoinCard>
  </div>
  <div class="text-center text-solarized-textSecondary mt-8">
    <NotSure />
  </div>
  <div class="text-center text-solarized-textSecondary mt-4">
    <Cost />
  </div>
</Container>
