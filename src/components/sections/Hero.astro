---
import Container from "../Container.astro";
import Button from "../Button.astro";
---

<Container class="py-16 md:py-24 text-center" background="hero">
  <h1 id="top" class="text-5xl md:text-6xl font-semibold tracking-tight mb-6 text-solarized-textHeading scroll-mt-24">
    Practice Group for Inner Work
  </h1>
  <p class="text-xl md:text-2xl text-solarized-textSecondary max-w-2xl mx-auto mb-8">
    A space to slow down, be honest, and listen to each other.
  </p>
  <div class="flex flex-col sm:flex-row justify-center gap-5 max-w-2xl mx-auto">
    <div class="sm:flex-1 sm:max-w-xs">
      <Button href="#join" class="w-full">See how to join</Button>
      <p class="mt-2 text-sm text-solarized-textSecondary text-balance">
        Sessions are on Wednesdays &amp; free to join.
      </p>
    </div>
    <div class="sm:flex-1 sm:max-w-xs">
      <Button variant="secondary" class="w-full" data-newsletter-open>Stay in the loop</Button>
      <p class="mt-2 text-sm text-solarized-textSecondary text-balance">
        Newsletter for one-off events &amp; updates.
      </p>
    </div>
  </div>
  <p class="mt-8">
    <a
      href="https://www.nikolasburk.com/blog/starting-a-practice-group-for-inner-work/"
      target="_blank"
      rel="noopener"
      class="text-solarized-textSecondary"
    >
      Why this exists ↗
    </a>
  </p>
</Container>
