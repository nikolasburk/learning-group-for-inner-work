---
interface Props {
  value: string;
  label?: string;
}

const { value, label = "Copy" } = Astro.props;
---

<button
  type="button"
  data-copy-value={value}
  aria-label={label}
  title={label}
  class="inline-flex items-center justify-center w-8 h-8 rounded-lg transition-all duration-200 bg-solarized-violet text-white hover:shadow-lg transform hover:-translate-y-0.5"
>
  <svg class="copy-icon w-4 h-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <rect x="7" y="7" width="9" height="9" rx="1.5" class="stroke-current" stroke-width="1.5" />
    <path
      d="M4 13V5.5A1.5 1.5 0 0 1 5.5 4H13"
      class="stroke-current"
      stroke-width="1.5"
      stroke-linecap="round"
    />
  </svg>
  <svg class="check-icon hidden w-4 h-4" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <path
      d="M5 10.5l3 3 7-7"
      class="stroke-current"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy-value]").forEach((button) => {
    const defaultLabel = button.getAttribute("aria-label") || "Copy";
    const copyIcon = button.querySelector(".copy-icon");
    const checkIcon = button.querySelector(".check-icon");
    button.addEventListener("click", async () => {
      const value = button.getAttribute("data-copy-value") || "";
      try {
        await navigator.clipboard.writeText(value);
        copyIcon?.classList.add("hidden");
        checkIcon?.classList.remove("hidden");
        button.setAttribute("aria-label", "Copied!");
        button.setAttribute("title", "Copied!");
      } catch (err) {
        button.setAttribute("aria-label", "Copy failed");
        button.setAttribute("title", "Copy failed");
      }
      setTimeout(() => {
        copyIcon?.classList.remove("hidden");
        checkIcon?.classList.add("hidden");
        button.setAttribute("aria-label", defaultLabel);
        button.setAttribute("title", defaultLabel);
      }, 1500);
    });
  });
</script>
