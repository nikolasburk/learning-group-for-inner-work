---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div
  class="rounded-xl border border-solarized-base2 p-6 flex flex-col h-full hover:shadow-md transition-shadow"
>
  <h3 class="text-lg font-bold mb-2 text-solarized-textHeading">{title}</h3>
  <div class="prose [&_p]:text-base [&>p:last-child]:mb-0">
    <slot />
  </div>
</div>
