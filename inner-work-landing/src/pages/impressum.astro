---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import SectionHeading from "../components/SectionHeading.astro";
---

<Layout
	title="Legal Notice (Impressum) — Inner Work"
	description="Legal notice (Impressum) for the Inner Work practice group, according to §5 DDG."
>
	<Container class="prose">
		<SectionHeading title="Legal Notice (Impressum)" />

		<h3>Information according to § 5 DDG</h3>
		<p>
			[FIRST NAME LAST NAME]<br />
			[STREET NUMBER]<br />
			[POSTAL CODE CITY]<br />
			Germany
		</p>

		<h3>Contact</h3>
		<p>
			Email: [EMAIL]<br />
			[Phone: OPTIONAL — only if one exists]
		</p>

		<h3>VAT identification number according to § 27a UStG</h3>
		<p>[VAT ID]</p>

		<h3>Responsible for content</h3>
		<p>[FIRST NAME LAST NAME], address as above</p>
	</Container>
</Layout>

