---
import Layout from "../layouts/Layout.astro";
import Container from "../components/Container.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CopyIbanButton from "../components/CopyIbanButton.astro";
---

<Layout
	title="Support — Inner Work"
	description="Optional ways to support the Inner Work practice group's running costs."
>
	<Container class="prose">
		<SectionHeading title="Support" />

		<p>
			This group is free and will stay that way. If you've been to a few sessions and want to
			chip in for the running costs, you're welcome to — it's entirely optional and makes no
			difference to your place in the group.
		</p>

		<h3>PayPal</h3>
		<!--
			Must be a link to a PayPal.me page tied to a business account, not a personal one.
			Do not use PayPal's "Donate" button/feature — it requires proof of nonprofit status,
			which this sole proprietorship does not have.
		-->
		<p><a href="[PAYPAL.ME LINK]">[PAYPAL.ME LINK]</a></p>

		<h3>Bank transfer</h3>
		<p class="mb-2">[ACCOUNT HOLDER]</p>
		<div class="mb-2 text-lg leading-relaxed text-solarized-textBody flex flex-wrap items-center gap-3">
			<span>IBAN</span>
			<CopyIbanButton iban="[IBAN]" />
		</div>
		<p>Reference: [REFERENCE, e.g. "Support"]</p>

		<p>
			Please note: contributions are voluntary and are not tax-deductible donations. I can't
			issue donation receipts.
		</p>
	</Container>
</Layout>
