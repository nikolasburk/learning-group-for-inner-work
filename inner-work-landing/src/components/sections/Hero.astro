---
import Container from "../Container.astro";
import Button from "../Button.astro";
---

<Container class="py-16 md:py-24 text-center" background="hero">
  <h1 id="top" class="text-5xl md:text-6xl font-semibold tracking-tight mb-6 text-solarized-textHeading scroll-mt-24">
    Practice Group for Inner Work
  </h1>
  <p class="text-xl md:text-2xl text-solarized-textSecondary max-w-2xl mx-auto mb-8">
    A space to slow down, be honest, and listen to each other.
  </p>
  <div>
    <Button href="#join">See how to join</Button>
  </div>
</Container>
