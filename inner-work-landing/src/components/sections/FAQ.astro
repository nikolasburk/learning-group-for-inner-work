---
import { getCollection, render } from "astro:content";
import Container from "../Container.astro";
import SectionHeading from "../SectionHeading.astro";
import FAQItem from "../FAQItem.astro";

const faqs = (await getCollection("faq")).sort(
  (a, b) => a.data.order - b.data.order,
);
const renderedFaqs = await Promise.all(
  faqs.map(async (entry) => {
    const { Content } = await render(entry);
    return { question: entry.data.question, Content };
  }),
);
---

<Container>
  <SectionHeading title="FAQ" id="faq" />
  <div class="divide-y divide-solarized-base2 mt-6">
    {
      renderedFaqs.map(({ question, Content }) => (
        <FAQItem question={question}>
          <Content />
        </FAQItem>
      ))
    }
  </div>
</Container>
