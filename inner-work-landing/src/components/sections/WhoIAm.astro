---
import { getEntry, render } from "astro:content";
import Container from "../Container.astro";
import SectionHeading from "../SectionHeading.astro";
import Avatar from "../Avatar.astro";

const entry = (await getEntry("copy", "who-i-am"))!;
const { Content } = await render(entry);
---

<Container>
  <SectionHeading title="Who I am" id="who-i-am" />
  <div class="flex flex-col md:flex-row gap-8 items-start mt-6">
    <Avatar src="/images/nburk.webp" alt="Nikolas Burk" />
    <div class="prose flex-1">
      <Content />
    </div>
  </div>
</Container>
