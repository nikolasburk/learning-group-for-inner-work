---
interface Props {
  title: string;
  id?: string;
}

const { title, id: idProp } = Astro.props;

function slugify(text: string): string {
  return text
    .toLowerCase()
    .trim()
    .replace(/\s+/g, "-");
}

const id = idProp ?? slugify(title);
---

<h2 id={id} class="text-2xl sm:text-3xl font-bold scroll-mt-24">
  <a
    href={`#${id}`}
    class="text-inherit no-underline hover:underline decoration-solarized-violet/50"
  >
    {title}
  </a>
</h2>
