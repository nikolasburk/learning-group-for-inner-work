---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"a">;

const { href, class: className, ...props } = Astro.props;
---

<a
  href={href}
  class:list={[
    "group inline-block px-3 py-2 md:px-4 no-underline text-solarized-textBody",
    className,
  ]}
  {...props}
>
  <span class="inline-block px-2 py-1 rounded text-sm md:text-base group-hover:bg-solarized-sharpieViolet group-hover:text-solarized-base03 transition-colors">
    <slot />
  </span>
</a>
