---
interface Props {
  iban: string;
}

const { iban } = Astro.props;
---

<div class="flex flex-wrap items-center gap-3">
  <code class="px-3 py-1.5 rounded bg-solarized-base2 text-solarized-violet font-mono text-base">{iban}</code>
  <button
    type="button"
    data-copy-iban={iban}
    class="inline-flex items-center px-4 py-1.5 rounded-lg text-sm transition-all duration-200 bg-solarized-violet text-white hover:shadow-lg transform hover:-translate-y-0.5"
  >
    Copy IBAN
  </button>
</div>

<script>
  document.querySelectorAll("[data-copy-iban]").forEach((button) => {
    const defaultLabel = button.textContent;
    button.addEventListener("click", async () => {
      const iban = button.getAttribute("data-copy-iban") || "";
      try {
        await navigator.clipboard.writeText(iban);
        button.textContent = "Copied!";
      } catch (err) {
        button.textContent = "Copy failed";
      }
      setTimeout(() => {
        button.textContent = defaultLabel;
      }, 1500);
    });
  });
</script>
