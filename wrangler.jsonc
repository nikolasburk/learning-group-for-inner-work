{
  "name": "inner-work-landing",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "innerwork.nikolasburk.com", "custom_domain": true }],
  "vars": {
    "FROM_EMAIL": "nikolas.burk@gmail.com", // TODO: replace with a verified Brevo sender address on your domain
    "FROM_NAME": "Nikolas — Practice group for inner work",
    "ZOOM_LINK": "https://zoom.us/j/73412743879?pwd=WuxartnGIjWgZxFl7BFQfQW16PMYJ7.1", // hostname-free form on purpose: routes to whatever cluster the account is on (a usNNweb. host breaks when the account tier changes)
    "NOTIFY_EMAIL": "nikolas.burk@gmail.com", // where host notifications are sent: applications, open-session signups and cancellations, timezone interest
    // Brevo list for explicit newsletter opt-ins only: "Newsletter | Inner Work Practice Group"
    "BREVO_NEWSLETTER_LIST_ID": "7",
    // Brevo catch-all list — every email anyone leaves, through any form
    "BREVO_CONTACTS_LIST_ID": "8"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "inner-work-signups",
      "database_id": "3496eb88-e534-4219-a367-4d9bc15e4c08",
      "migrations_dir": "migrations"
    }
  ]
}
